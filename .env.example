# Run: node scripts/setup.mjs
# It creates an ignored .env file with random local secrets.
# To display local demo credentials: node scripts/setup.mjs --show-credentials
# All four demo accounts share the generated DEMO_PASSWORD.
POSTGRES_PASSWORD=
JWT_KEY=
DEMO_PASSWORD=
DEMO_ENABLED=true
TASKFLOW_PORT=8080
HOLIDAY_API_MODE=Stub
HOLIDAY_API_STUB_SCENARIO=Success
